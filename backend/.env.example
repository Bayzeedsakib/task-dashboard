# Copy this file to .env and adjust the values.

# Port the API listens on.
PORT=5000

# Secret used to sign login tokens. Must be at least 32 random characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# How long a login token stays valid (e.g. 1h, 12h, 1d).
JWT_EXPIRES_IN=1d

# Comma-separated list of browser origins allowed to call the API.
CORS_ORIGIN=http://localhost:5173

# SQLite database file. Relative paths are resolved from the backend folder.
DB_PATH=tasks.db

# Rate limiting: window length in ms, max requests per window per IP,
# and max failed login/register attempts per window per IP.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=20

# Set to the number of reverse proxies in front of the API (0 when none),
# so rate limiting sees the real client IP.
TRUST_PROXY=0
